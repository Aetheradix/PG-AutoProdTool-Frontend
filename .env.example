# =============================================================================
# Automation Frontend - Environment Variables Template
# =============================================================================
# Copy this file to .env or .env.local to override defaults:
# cp .env.example .env

# Backend API URL (Optional if using Vite development server proxy)
# Default development proxy redirects '/api' to 'http://localhost:8000'
VITE_API_BASE_URL=http://localhost:8000

# App Title & Environment
VITE_APP_TITLE=PG AutoProdTool
VITE_APP_ENV=development
